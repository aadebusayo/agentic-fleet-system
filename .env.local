# ===== Core LLM selection =====
AGENT_LLM_PROVIDER=local-endpoint
AGENT_LLM_FAILOVER_ENABLED=true
AGENT_LLM_FAILOVER_CHAIN=openai-compatible,azure-openai,anthropic,gemini,local-endpoint
AGENT_LLM_MODEL=deepseek-r1:1.5b
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=512
AGENT_LLM_TIMEOUT_SECONDS=30

# ===== OpenAI-compatible defaults =====
AGENT_LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
AGENT_LLM_API_KEY=

# ===== Azure OpenAI =====
AGENT_AZURE_OPENAI_DEPLOYMENT=gpt-4o-chatter-ai
AGENT_AZURE_OPENAI_API_VERSION=2024-08-01-preview
AGENT_AZURE_OPENAI_ENDPOINT=https://chatter-dev-bot.openai.azure.com/
AGENT_AZURE_OPENAI_API_KEY=2ac50892378a4891acded8a4e3b4f7f2

# ===== Anthropic =====
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
AGENT_ANTHROPIC_VERSION=2023-06-01

# ===== Gemini =====
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_ENDPOINT=

# ===== Local endpoint mode =====
AGENT_LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
AGENT_LOCAL_LLM_FORMAT=openai-compatible
AGENT_LOCAL_LLM_API_KEY=

# ===== Dev/test fallback only =====
AGENT_ALLOW_STUB_LLM=false


